# Copy this file to `.env` (same folder as manage.py) and fill in real values.
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# `.env` is git-ignored. This example file is safe to commit: it contains NO real secrets.
# Format rules: one KEY=value per line, no spaces around `=`, no quotes.

# Django's master secret. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-long-random-value

# Hosts allowed to serve the site in PRODUCTION (comma-separated, no spaces).
# On PythonAnywhere add <your-username>.pythonanywhere.com here.
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only: True on the deployed (HTTPS) site, False to try production mode locally.
HTTPS_ONLY=True

# ---------------------------------------------------------------------------------------
# AI features (README_AI.md)
# ---------------------------------------------------------------------------------------
# External API: a free Groq key from https://console.groq.com/keys (no card needed).
# Without it the tutor, coach and harmony assistant use their rule-based fallbacks.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
p
# Local Hugging Face model (optional). Needs: pip install -r requirements-ai.txt
# Downloaded automatically on first use (~5 GB). Leave False on PythonAnywhere.
AI_LOCAL_ENABLED=False
AI_LOCAL_MODEL=ibm-granite/granite-3.3-2b-instruct

# Model runs per account per minute, across all AI features.
AI_REQUESTS_PER_MINUTE=10
